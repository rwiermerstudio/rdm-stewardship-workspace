{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rwiermerstudio/rdm-stewardship-workspace/blob/main/schemas/fictional-institution.schema.json",
  "title": "Fictional institution test catalogue (never actual research records)",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution", "people", "groups", "practices", "repositories", "policies", "projects"],
  "properties": {
    "institution": {"type":"object","required":["id","name","status","policy_notice"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"country":{"type":"string"},"status":{"const":"synthetic"},"policy_notice":{"type":"string"}}},
    "people": {"type":"array","minItems":1,"items":{"type":"object","required":["id","name","role","disciplines","contact"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"role":{"enum":["researcher","data-steward","privacy-reviewer","repository-curator","community-authority"]},"disciplines":{"type":"array","items":{"type":"string"}},"contact":{"type":"string"}}}},
    "groups": {"type":"array","minItems":1,"items":{"type":"object","required":["id","name","lead","members"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"lead":{"type":"string"},"members":{"type":"array","minItems":1,"items":{"type":"string"}}}}},
    "practices": {"type":"array","items":{"type":"object","required":["id","description"],"properties":{"id":{"type":"string"},"description":{"type":"string"}}}},
    "repositories": {"type":"array","minItems":1,"items":{"type":"object","required":["id","name","formats","max_gib","allowed_classifications","residency","access","metadata_visibility","custodian","status"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"community_only":{"type":"boolean"},"formats":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"max_gib":{"type":"number","exclusiveMinimum":0},"allowed_classifications":{"type":"array","items":{"enum":["open-candidate","restricted"]}},"residency":{"type":"array","items":{"type":"string"}},"access":{"type":"array","items":{"enum":["open","mediated","enclave"]}},"metadata_visibility":{"type":"array","items":{"enum":["public","private"]}},"custodian":{"type":"string"},"status":{"const":"candidate-only"}}}},
    "policies": {"type":"array","minItems":1,"items":{"type":"object","required":["id","version","authority","scope","effect","reason","citation","approved_by","effective_from"],"properties":{"id":{"type":"string"},"version":{"type":"string"},"authority":{"enum":["institution","funder","discipline","community"]},"scope":{"type":"object","properties":{"all":{"type":"boolean"},"classification":{"type":"string"},"discipline":{"type":"string"},"community_governed":{"type":"boolean"},"funder":{"type":"string"}},"additionalProperties":false},"effect":{"enum":["document","review","preference"]},"artifact":{"type":"string"},"owner":{"type":"string"},"reason":{"type":"string"},"citation":{"type":"string"},"approved_by":{"type":"string"},"effective_from":{"type":"string","format":"date"},"effective_until":{"type":"string","format":"date"}}}},
    "projects": {"type":"array","minItems":1,"items":{"type":"object","required":["id","title","group","pi","steward","discipline","funder","size_gib","formats","classification","residency","community_governed","consent_status","metadata_visibility","inputs","output","method","change_kind","standards"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"group":{"type":"string"},"pi":{"type":"string"},"steward":{"type":"string"},"discipline":{"type":"string"},"funder":{"type":"string"},"size_gib":{"type":"number","exclusiveMinimum":0},"formats":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"classification":{"enum":["open-candidate","restricted","unknown"]},"residency":{"type":"string"},"community_governed":{"type":["boolean","null"]},"consent_status":{"enum":["confirmed","limited","unknown","not-applicable"]},"metadata_visibility":{"enum":["public","private"]},"inputs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"output":{"type":"string"},"method":{"type":"string"},"change_kind":{"enum":["correction","transformation","protocol","deposit"]},"standards":{"type":"array","items":{"type":"string"}}}}}
  }
}
